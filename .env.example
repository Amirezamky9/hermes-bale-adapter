# ────────────────────────────────────────────────────────────────
# Bale Platform Adapter — Environment Variables
# Copy this file to .env and fill in your values.
#   cp .env.example .env
# NEVER commit the real .env file.
# ────────────────────────────────────────────────────────────────

# ── Required ────────────────────────────────────────────────────
# Bale bot token from @botfather (https://ble.ir/botfather)
# Format: 123456789:ABCdef123...
BALE_BOT_TOKEN=

# ── Optional: authorization ─────────────────────────────────────
# Comma-separated Bale user IDs allowed to talk to the bot.
# Empty = everyone can talk (NOT recommended).
BALE_ALLOWED_USERS=

# Set to 1 to allow ANY Bale user to trigger the bot (dev only).
BALE_ALLOW_ALL_USERS=0

# ── Optional: home channel (cron / notification delivery) ───────
# Default chat ID for cron jobs and notifications.
BALE_HOME_CHANNEL=

# Display name for the home channel (shown in Hermes status).
BALE_HOME_CHANNEL_NAME=
